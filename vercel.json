{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/cleopatras-path", "destination": "/cleopatras-path/index.html" },
    { "source": "/cleopatras-path/", "destination": "/cleopatras-path/index.html" },
    { "source": "/salt-lake", "destination": "/salt-lake/index.html" },
    { "source": "/salt-lake/", "destination": "/salt-lake/index.html" },
    { "source": "/((?!cleopatras-path|salt-lake).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(*), microphone=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/backgrounds/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
